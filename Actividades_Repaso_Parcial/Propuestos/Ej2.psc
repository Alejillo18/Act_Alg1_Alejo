Algoritmo Ej2
	//Calcular area de un rectangulo
	definir base,altura,area Como Real
	Escribir "Ingrese la base: "
	leer base
	Escribir "Ingrese la Altura: "
	leer altura
	area <- base * altura
	Escribir "Para un rectangulo con base: ",base, " y altura de: ",altura, " Su area es: ", area
	
FinAlgoritmo
