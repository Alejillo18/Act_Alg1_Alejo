Algoritmo Ej4
	//Pedir dos nros y mostrar el mayor
	Escribir "Ingrese el primer nro: "
	leer nro1
	Escribir "Ingrese el Segundo nro: "
	leer nro2
	
	si nro1 > nro2 Entonces
		Escribir "El número ",nro1, " es mayor que ",nro2
	SiNo
		Escribir "El número ",nro2, " es mayor que ",nro1
	FinSi
FinAlgoritmo
